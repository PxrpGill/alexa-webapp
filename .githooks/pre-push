#!/bin/sh

echo "🔨 Running build check before push..."

BUILD_DIR="$(git rev-parse --show-toplevel)/src"

if [ ! -f "$BUILD_DIR/package.json" ]; then
  echo "❌ package.json not found in $BUILD_DIR"
  exit 1
fi

cd "$BUILD_DIR" || exit 1

CI=true pnpm build
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "❌ Build failed. Push rejected."
  echo "   Fix the build errors before pushing."
  exit 1
fi

echo "✅ Build passed."

echo ""
echo "🔍 Running security audit..."
pnpm audit --audit-level=high
AUDIT_EXIT=$?

if [ $AUDIT_EXIT -ne 0 ]; then
  echo ""
  echo "❌ Security audit found high/critical vulnerabilities. Push rejected."
  echo "   Run 'pnpm audit' for details, or 'pnpm audit --fix' to auto-fix."
  exit 1
fi

echo "✅ Security audit passed. Push allowed."
exit 0
